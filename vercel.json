{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "env": {
    "GMAIL_USER": "@GMAIL_USER",
    "GMAIL_APP_PASSWORD": "@GMAIL_APP_PASSWORD"
  }
}
