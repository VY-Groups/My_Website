# Portfolio Website Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# EMAIL CONFIGURATION (Required for contact/collaboration forms)
# ==========================================
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ==========================================
# ANALYTICS (Optional - choose one or more)
# ==========================================

# Plausible Analytics (Privacy-first, lightweight)
# Get domain from https://plausible.io
VITE_PLAUSIBLE_DOMAIN=yourdomain.com
# Optional: Custom API host (for self-hosted Plausible)
# VITE_PLAUSIBLE_API_HOST=https://plausible.yourdomain.com

# Umami Analytics (Privacy-friendly, self-hosted or cloud)
# Get website ID from https://umami.is or your self-hosted instance
VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional: Custom script URL (for self-hosted Umami)
# VITE_UMAMI_SCRIPT_URL=https://your-umami-domain.com/script.js

# Google Analytics 4
# Get Measurement ID from GA4 Admin > Data Streams > Web
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ==========================================
# SITE CONFIGURATION
# ==========================================
VITE_SITE_URL=https://yashkumardubey.dev

# ==========================================
# RECAPTCHA / HCAPTCHA (Optional - for form protection)
# ==========================================
VITE_HCAPTCHA_SITE_KEY=your-site-key
HCAPTCHA_SECRET_KEY=your-secret-key

# ==========================================
# WEBHOOK NOTIFICATIONS (Optional)
# ==========================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/xxx

# ==========================================
# CMS INTEGRATION (Optional - for Student Resources)
# Leave empty to use bundled static data
# ==========================================

# Option A: Notion (server-side, secure)
# NOTION_TOKEN=secret_xxx
# NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Option B: Airtable (server-side, secure)
# AIRTABLE_API_KEY=keyXXXXXXX
# AIRTABLE_BASE_ID=appXXXXXXX
# AIRTABLE_TABLE_NAME=Resources

# ==========================================
# EMAIL OPTIONS
# ==========================================
# Set to "true" to send auto-reply to form submitters
ENABLE_AUTO_REPLY=false